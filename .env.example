# ── Banco de dados (Neon PostgreSQL) ──────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/copy-nomade-trader?sslmode=require"

# ── Painel interno (Matheus) — senha compartilhada ────────────────
ADMIN_PASSWORD="troque-por-uma-senha-forte"
# Secret usado pra assinar o cookie de sessão do painel (gere com: openssl rand -base64 32)
ADMIN_SESSION_SECRET=""

# ── NextAuth (área do investidor — magic link) ────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ── Resend (envio do magic link por e-mail) ───────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Copy Nômade Trader <login@seudominio.com>"
